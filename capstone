<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Buildmart — Hardware &amp; Home</title>
<style>
  :root {
    --ink: #1c2321;
    --paper: #f6f4ef;
    --card: #ffffff;
    --line: #e3ded4;
    --green: #1f5f4b;
    --amber: #e08a1e;
    --amber-dark: #c2761a;
    --muted: #6b7270;
    --radius: 10px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
  }

  /* ---------- Header ---------- */
  header {
    background: var(--green);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .bar {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .logo {
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo span { color: var(--amber); }
  .logo svg { width: 26px; height: 26px; }

  .search {
    flex: 1;
    display: flex;
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    max-width: 520px;
  }
  .search input {
    flex: 1;
    border: 0;
    padding: 10px 14px;
    font-size: .95rem;
    outline: none;
  }
  .search button {
    border: 0;
    background: var(--amber);
    color: #fff;
    padding: 0 18px;
    font-weight: 600;
    cursor: pointer;
  }

  /* ---------- Layout ---------- */
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 20px 60px;
  }
  .page-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 4px; }
  .page-sub { color: var(--muted); margin-bottom: 24px; font-size: .95rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  /* ---------- Product card ---------- */
  .product {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .product:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(28,35,33,.08); }
  .thumb {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    font-size: 3.2rem;
    background: linear-gradient(135deg, #f0ede6, #e7e2d8);
  }
  .product-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .product-name { font-weight: 600; font-size: .98rem; }
  .product-meta { font-size: .8rem; color: var(--muted); }
  .price-row { display: flex; align-items: baseline; gap: 6px; margin-top: auto; }
  .price { font-size: 1.25rem; font-weight: 800; }
  .price-unit { font-size: .78rem; color: var(--muted); }

  .add-btn {
    border: 0;
    background: var(--amber);
    color: #fff;
    font-weight: 600;
    padding: 9px 0;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 6px;
  }
  .add-btn:hover { background: var(--amber-dark); }
</style>
</head>
<body>

<header>
  <div class="bar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="#e08a1e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 7l-7 7-3-3"/><path d="M3 21l9-9"/><path d="M14.5 3.5a3 3 0 0 1 4 4l-4-4z"/></svg>
      Build<span>mart</span>
    </div>
    <div class="search">
      <input type="text" placeholder="Search tools, paint, timber..." aria-label="Search products">
      <button>Search</button>
    </div>
  </div>
</header>

<main class="wrap">
  <h1 class="page-title">Power Tools &amp; Hardware</h1>
  <p class="page-sub">Free in-store pickup. Prices include GST.</p>
  <div class="grid" id="grid"></div>
</main>

<script>
  // ---- Product catalogue ----
  const products = [
    { id: 1, name: "Bolt", price: 12.00, unit: "each", emoji: "🔩" },
    { id: 2, name: "Claw Hammer 450g", meta: "Fibreglass handle", price: 24.95, unit: "each", emoji: "🔨" },
    { id: 3, name: "Interior Paint 4L", meta: "Low-sheen, white", price: 58.00, unit: "tin", emoji: "🪣" },
    { id: 4, name: "Pine Timber 2.4m", meta: "90 x 45mm treated", price: 12.40, unit: "length", emoji: "🪵" },
    { id: 5, name: "LED Work Light", meta: "2000 lumen, rechargeable", price: 79.50, unit: "each", emoji: "💡" },
    { id: 6, name: "Tape Measure 8m", meta: "Magnetic hook", price: 18.90, unit: "each", emoji: "📏" },
    { id: 7, name: "Garden Hose 30m", meta: "Kink-resistant", price: 44.00, unit: "each", emoji: "🌿" },
    { id: 8, name: "Safety Glasses", meta: "Anti-fog, clear", price: 9.95, unit: "pair", emoji: "🥽" },
  ];

  // ---- Render product grid ----
  function renderGrid() {
    document.getElementById("grid").innerHTML = products.map(p => `
      <div class="product">
        <div class="thumb">${p.emoji}</div>
        <div class="product-body">
          <div class="product-name">${p.name}</div>
          <div class="product-meta">${p.meta || ""}</div>
          <div class="price-row">
            <span class="price">$${p.price.toFixed(2)}</span>
            <span class="price-unit">/ ${p.unit}</span>
          </div>
          <button class="add-btn">Add to cart</button>
        </div>
      </div>
    `).join("");
  }

  renderGrid();
</script>
</body>
</html>
