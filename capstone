<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Buildmart — Hardware &amp; Home</title>
<style>
  :root {
    --ink: #1c2321;
    --paper: #f6f4ef;
    --card: #ffffff;
    --line: #e3ded4;
    --green: #1f5f4b;
    --green-dark: #184c3b;
    --amber: #e08a1e;
    --amber-dark: #c2761a;
    --muted: #6b7270;
    --radius: 10px;
    --shadow: 0 1px 3px rgba(28,35,33,.08), 0 8px 24px rgba(28,35,33,.05);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- Header ---------- */
  header {
    background: var(--green);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 40;
    box-shadow: 0 2px 10px rgba(0,0,0,.12);
  }
  .bar {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .logo {
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo span { color: var(--amber); }
  .logo svg { width: 26px; height: 26px; }

  .search {
    flex: 1;
    display: flex;
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    max-width: 520px;
  }
  .search input {
    flex: 1;
    border: 0;
    padding: 10px 14px;
    font-size: .95rem;
    outline: none;
  }
  .search button {
    border: 0;
    background: var(--amber);
    color: #fff;
    padding: 0 18px;
    font-weight: 600;
    cursor: pointer;
  }

  .cart-btn {
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.25);
    color: #fff;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .cart-btn:hover { background: rgba(255,255,255,.2); }
  .cart-count {
    background: var(--amber);
    color: #fff;
    border-radius: 999px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    font-size: .8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- Layout ---------- */
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 20px 60px;
  }
  .page-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 4px;
    letter-spacing: -.4px;
  }
  .page-sub { color: var(--muted); margin-bottom: 24px; font-size: .95rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  /* ---------- Product card ---------- */
  .product {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .product:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .thumb {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    font-size: 3.2rem;
    background: linear-gradient(135deg, #f0ede6, #e7e2d8);
  }
  .product-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .product-name { font-weight: 600; font-size: .98rem; }
  .product-meta { font-size: .8rem; color: var(--muted); }
  .price-row { display: flex; align-items: baseline; gap: 6px; margin-top: auto; }
  .price { font-size: 1.25rem; font-weight: 800; }
  .price-unit { font-size: .78rem; color: var(--muted); }

  .add-btn {
    border: 0;
    background: var(--amber);
    color: #fff;
    font-weight: 600;
    padding: 9px 0;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 6px;
  }
  .add-btn:hover { background: var(--amber-dark); }
  .add-btn:active { transform: scale(.98); }

  /* ---------- Cart drawer ---------- */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(28,35,33,.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
    z-index: 50;
  }
  .overlay.open { opacity: 1; pointer-events: auto; }

  .drawer {
    position: fixed;
    top: 0; right: 0;
    height: 100%;
    width: 400px;
    max-width: 92vw;
    background: var(--paper);
    z-index: 60;
    transform: translateX(100%);
    transition: transform .28s cubic-bezier(.4,0,.2,1);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 30px rgba(0,0,0,.2);
  }
  .drawer.open { transform: translateX(0); }

  .drawer-head {
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
  }
  .drawer-head h2 { font-size: 1.1rem; }
  .close-x {
    border: 0; background: transparent; font-size: 1.6rem;
    cursor: pointer; color: var(--muted); line-height: 1;
  }

  .cart-items { flex: 1; overflow-y: auto; padding: 12px 16px; }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 60px 20px;
  }
  .empty-emoji { font-size: 2.6rem; display: block; margin-bottom: 10px; }

  .cart-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px;
    display: flex;
    gap: 12px;
    margin-bottom: 10px;
  }
  .ci-thumb {
    width: 52px; height: 52px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f0ede6, #e7e2d8);
    display: grid; place-items: center;
    font-size: 1.6rem; flex-shrink: 0;
  }
  .ci-info { flex: 1; min-width: 0; }
  .ci-name { font-weight: 600; font-size: .9rem; }
  .ci-price { color: var(--muted); font-size: .82rem; }
  .ci-controls { display: flex; align-items: center; gap: 10px; margin-top: 8px; }

  .qty {
    display: flex; align-items: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .qty button {
    border: 0; background: #f3f0e9;
    width: 28px; height: 28px;
    cursor: pointer; font-size: 1rem;
    color: var(--ink);
  }
  .qty button:hover { background: #e7e2d8; }
  .qty span { width: 34px; text-align: center; font-size: .9rem; font-weight: 600; }

  .remove {
    border: 0; background: transparent;
    color: #b13b3b; font-size: .8rem;
    cursor: pointer; margin-left: auto;
  }
  .remove:hover { text-decoration: underline; }
  .ci-line-total { font-weight: 700; font-size: .92rem; }

  .drawer-foot {
    border-top: 1px solid var(--line);
    background: #fff;
    padding: 18px 20px;
  }
  .sum-row {
    display: flex; justify-content: space-between;
    font-size: .9rem; color: var(--muted);
    margin-bottom: 6px;
  }
  .sum-row.total {
    color: var(--ink); font-weight: 800; font-size: 1.15rem;
    margin: 10px 0 14px;
  }
  .checkout {
    width: 100%; border: 0;
    background: var(--green);
    color: #fff; font-weight: 700;
    padding: 13px 0; border-radius: 8px;
    cursor: pointer; font-size: 1rem;
  }
  .checkout:hover { background: #184c3b; }
  .checkout:disabled { background: #b7c0bb; cursor: not-allowed; }

  /* ---------- Toast ---------- */
  .toast {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--ink);
    color: #fff;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: .9rem;
    opacity: 0;
    pointer-events: none;
    transition: all .25s ease;
    z-index: 80;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 560px) {
    .search { display: none; }
    .bar { gap: 10px; }
  }
</style>
</head>
<body>

<header>
  <div class="bar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="#e08a1e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 7l-7 7-3-3"/><path d="M3 21l9-9"/><path d="M14.5 3.5a3 3 0 0 1 4 4l-4-4z"/></svg>
      Build<span>mart</span>
    </div>
    <div class="search">
      <input type="text" placeholder="Search tools, paint, timber..." aria-label="Search products">
      <button>Search</button>
    </div>
    <button class="cart-btn" onclick="openCart()">
      Cart
      <span class="cart-count" id="cartCount">0</span>
    </button>
  </div>
</header>

<main class="wrap">
  <h1 class="page-title">Power Tools &amp; Hardware</h1>
  <p class="page-sub">Free in-store pickup. Prices include GST.</p>
  <div class="grid" id="grid"></div>
</main>

<!-- Cart drawer -->
<div class="overlay" id="overlay" onclick="closeCart()"></div>
<aside class="drawer" id="drawer" aria-label="Shopping cart">
  <div class="drawer-head">
    <h2>Your Cart</h2>
    <button class="close-x" onclick="closeCart()" aria-label="Close cart">&times;</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="drawer-foot">
    <div class="sum-row"><span>Subtotal</span><span id="subtotal">$0.00</span></div>
    <div class="sum-row"><span>GST included (10%)</span><span id="gst">$0.00</span></div>
    <div class="sum-row"><span>Delivery</span><span id="delivery">Free pickup</span></div>
    <div class="sum-row total"><span>Total</span><span id="total">$0.00</span></div>
    <button class="checkout" id="checkoutBtn" onclick="checkout()" disabled>Checkout</button>
  </div>
</aside>

<div class="toast" id="toast"></div>

<script>
  // ---- Product catalogue ----
  const products = [
    { id: 1, name: "Cordless Drill 18V", meta: "2.0Ah battery + charger", price: 129.00, unit: "each", emoji: "🔩" },
    { id: 2, name: "Claw Hammer 450g", meta: "Fibreglass handle", price: 24.95, unit: "each", emoji: "🔨" },
    { id: 3, name: "Interior Paint 4L", meta: "Low-sheen, white", price: 58.00, unit: "tin", emoji: "🪣" },
    { id: 4, name: "Pine Timber 2.4m", meta: "90 x 45mm treated", price: 12.40, unit: "length", emoji: "🪵" },
    { id: 5, name: "LED Work Light", meta: "2000 lumen, rechargeable", price: 79.50, unit: "each", emoji: "💡" },
    { id: 6, name: "Tape Measure 8m", meta: "Magnetic hook", price: 18.90, unit: "each", emoji: "📏" },
    { id: 7, name: "Garden Hose 30m", meta: "Kink-resistant", price: 44.00, unit: "each", emoji: "🌿" },
    { id: 8, name: "Safety Glasses", meta: "Anti-fog, clear", price: 9.95, unit: "pair", emoji: "🥽" },
  ];

  // cart = { productId: quantity }
  let cart = {};

  // ---- Render product grid ----
  function renderGrid() {
    document.getElementById("grid").innerHTML = products.map(p => `
      <div class="product">
        <div class="thumb">${p.emoji}</div>
        <div class="product-body">
          <div class="product-name">${p.name}</div>
          <div class="product-meta">${p.meta}</div>
          <div class="price-row">
            <span class="price">$${p.price.toFixed(2)}</span>
            <span class="price-unit">/ ${p.unit}</span>
          </div>
          <button class="add-btn" onclick="addToCart(${p.id})">Add to cart</button>
        </div>
      </div>
    `).join("");
  }

  // ---- Cart actions ----
  function addToCart(id) {
    cart[id] = (cart[id] || 0) + 1;
    renderCart();
    const p = products.find(x => x.id === id);
    showToast(`Added "${p.name}" to cart`);
  }

  function changeQty(id, delta) {
    cart[id] = (cart[id] || 0) + delta;
    if (cart[id] <= 0) delete cart[id];
    renderCart();
  }

  function removeItem(id) {
    delete cart[id];
    renderCart();
  }

  // ---- Render cart ----
  function renderCart() {
    const ids = Object.keys(cart);
    const itemsEl = document.getElementById("cartItems");
    const totalQty = ids.reduce((s, id) => s + cart[id], 0);
    document.getElementById("cartCount").textContent = totalQty;

    if (ids.length === 0) {
      itemsEl.innerHTML = `
        <div class="empty">
          <span class="empty-emoji">🛒</span>
          Your cart is empty.<br>Add some gear to get started.
        </div>`;
      document.getElementById("checkoutBtn").disabled = true;
    } else {
      itemsEl.innerHTML = ids.map(id => {
        const p = products.find(x => x.id == id);
        const qty = cart[id];
        const lineTotal = (p.price * qty).toFixed(2);
        return `
          <div class="cart-item">
            <div class="ci-thumb">${p.emoji}</div>
            <div class="ci-info">
              <div class="ci-name">${p.name}</div>
              <div class="ci-price">$${p.price.toFixed(2)} / ${p.unit}</div>
              <div class="ci-controls">
                <div class="qty">
                  <button onclick="changeQty(${p.id}, -1)" aria-label="Decrease">−</button>
                  <span>${qty}</span>
                  <button onclick="changeQty(${p.id}, 1)" aria-label="Increase">+</button>
                </div>
                <span class="ci-line-total">$${lineTotal}</span>
                <button class="remove" onclick="removeItem(${p.id})">Remove</button>
              </div>
            </div>
          </div>`;
      }).join("");
      document.getElementById("checkoutBtn").disabled = false;
    }

    // Totals (prices are GST-inclusive, so back out the GST component)
    const subtotal = ids.reduce((s, id) => {
      const p = products.find(x => x.id == id);
      return s + p.price * cart[id];
    }, 0);
    const gst = subtotal - subtotal / 1.1;

    document.getElementById("subtotal").textContent = "$" + subtotal.toFixed(2);
    document.getElementById("gst").textContent = "$" + gst.toFixed(2);
    document.getElementById("total").textContent = "$" + subtotal.toFixed(2);
  }

  // ---- Drawer + toast ----
  function openCart() {
    document.getElementById("drawer").classList.add("open");
    document.getElementById("overlay").classList.add("open");
  }
  function closeCart() {
    document.getElementById("drawer").classList.remove("open");
    document.getElementById("overlay").classList.remove("open");
  }
  function checkout() {
    const total = document.getElementById("total").textContent;
    showToast(`Order placed! Total: ${total} 🎉`);
    cart = {};
    renderCart();
    setTimeout(closeCart, 800);
  }

  let toastTimer;
  function showToast(msg) {
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove("show"), 1800);
  }

  // ---- Init ----
  renderGrid();
  renderCart();
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeCart(); });
</script>
</body>
</html>
